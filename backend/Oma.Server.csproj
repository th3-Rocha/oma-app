<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Oma</RootNamespace>
    <AssemblyName>Oma.Server</AssemblyName>
    <Version>2.0.0</Version>
    <!-- Arch ships the SDK without the ASP.NET targeting pack; NuGet restores it instead -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- the server resolves wwwroot next to the binary, so dev builds need it there too -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
