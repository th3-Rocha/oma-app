# =========================
# oma-app root environment
# =========================

# Backend bind address (what Kestrel listens on)
BACKEND_BIND_URL=http://0.0.0.0:5172

# Backend port consumed by mobile auto-URL resolver
EXPO_PUBLIC_BACKEND_PORT=5172

# Optional overrides (if you want fixed explicit URLs instead of auto host)
# EXPO_PUBLIC_BACKEND_HTTP_URL=http://192.168.1.10:5172
# EXPO_PUBLIC_BACKEND_WS_URL=ws://192.168.1.10:5172/ws/terminal

# Expo runtime options
EXPO_HOST=lan
EXPO_PORT=8081
